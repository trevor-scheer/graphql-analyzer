{
  "name": "@graphql-analyzer/eslint-plugin",
  "version": "0.1.1-alpha.0",
  "description": "ESLint plugin for GraphQL, powered by graphql-analyzer. Drop-in replacement for @graphql-eslint/eslint-plugin.",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "graphql",
    "graphql-eslint",
    "lint",
    "linter"
  ],
  "homepage": "https://trevor-scheer.github.io/graphql-analyzer/linting/eslint-plugin/",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/trevor-scheer/graphql-analyzer.git",
    "directory": "packages/eslint-plugin"
  },
  "files": [
    "dist/"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test:unit": "NODE_ENV=test node --test test/integration.test.mjs test/parity.test.mjs"
  },
  "dependencies": {
    "@apollo/subgraph": "2.11.6",
    "@graphql-analyzer/core": "0.1.1-alpha.0",
    "@graphql-tools/code-file-loader": "8.1.32",
    "@graphql-tools/graphql-tag-pluck": "8.3.31",
    "@graphql-tools/merge": "9.1.9",
    "@graphql-tools/utils": "10.11.0",
    "graphql-config": "5.1.6"
  },
  "devDependencies": {
    "@graphql-eslint/eslint-plugin": "^4.0.0",
    "@types/node": "^20.0.0",
    "@vue/compiler-sfc": "3.5.42",
    "astrojs-compiler-sync": "1.1.1",
    "eslint": "^9.0.0",
    "svelte": "5.57.0",
    "svelte2tsx": "0.7.61",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "eslint": "^8.40.0 || ^9.0.0",
    "graphql": "^16.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
